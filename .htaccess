Options -Indexes -MultiViews

# Bloquea archivos internos/sensibles por nombre.

<FilesMatch "(^\.|\.sql$|\.log$|\.ini$|^README.*\.md$|^DEPLOYMENT_ORDER\.txt$|^composer\.(json|lock)$)">
Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

# Nunca exponer infraestructura compartida de EU Tools.

RewriteRule ^shared(?:/|$) - [F,L,NC]

# Nunca exponer capas privadas del Core.

RewriteRule ^core/(?:app|bootstrap|scripts|sql|storage|vendor)(?:/|$) - [F,L,NC]

# Hub protegido del Core.
RewriteRule ^$ core/public/index.php [L]

# Login del Core.
RewriteRule ^login/?$ core/public/login.php [L,NC]

# Registro y activación de cuentas Core.
RewriteRule ^register/?$ core/public/register.php [L,NC]
RewriteRule ^verify-email/?$ core/public/verify-email.php [L,NC]
RewriteRule ^accept-invitation/?$ core/public/accept-invitation.php [L,NC]

# Compatibilidad temporal con URLs heredadas de Maintenance.
RewriteRule ^maintenance/register\.html$ /register [R=302,L,NE,NC]
RewriteRule ^maintenance/verify-email\.html$ /verify-email [R=302,L,NE,NC]

# Administración web del Core.
RewriteRule ^admin/users/?$ core/public/admin/users.php [L,NC]

# Assets públicos del Core.
RewriteRule ^assets/(.*)$ core/public/assets/$1 [L]

# API central de autenticación.

RewriteRule ^api/auth/(csrf|login|me|logout|register|resend-verification|verify-email|invitation-context|accept-invitation)/?$ core/public/api/auth/$1.php [L,NC]

# API del Hub.
RewriteRule ^api/hub/apps/?$ core/public/api/hub/apps.php [L,NC]

# Administración global de usuarios.
RewriteRule ^api/admin/users/(context|list|create|resend-invitation)/?$ core/public/api/admin/users/$1.php [L,NC]

# Nunca exponer capas privadas de Maintenance.

RewriteRule ^maintenance/(?:app|bootstrap|scripts|sql|storage|vendor)(?:/|$) - [F,L,NC]

# Defensa adicional si por accidente se desplegara .git.

RewriteRule ^\.git(?:/|$) - [F,L,NC]

# Endpoint temporal/definitivo de infraestructura del Core.

RewriteRule ^api/health/?$ core/public/api/health.php [L,NC]
</IfModule>
