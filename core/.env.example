APP_ENV=production
APP_DEBUG=false
APP_URL=https://tools.estrategiaurbana.info
APP_TIMEZONE=America/Mexico_City

DB_HOST=localhost
DB_PORT=3306
DB_NAME=u170017077_tools
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

SESSION_NAME=EUTOOLSSESSID
SESSION_LIFETIME_MINUTES=30
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=Lax
SESSION_COOKIE_PATH=/

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Invitaciones
USER_INVITATION_TTL_HOURS=72
USER_INVITATION_RESEND_COOLDOWN_MINUTES=10
USER_INVITATION_RESEND_MAX_PER_HOUR=5

# Verificación de correo / registro
EMAIL_VERIFICATION_TTL_MINUTES=60
REGISTRATION_MAX_PER_IP_HOUR=5
VERIFICATION_RESEND_COOLDOWN_MINUTES=10
VERIFICATION_RESEND_MAX_PER_HOUR=3

# Recuperación de contraseña
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_MAX_PER_IP_HOUR=10
PASSWORD_RESET_MAX_PER_USER_HOUR=3
PASSWORD_RESET_COOLDOWN_MINUTES=10

# smtp (producción), native (mail de PHP) o log (pruebas)
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_AUTH=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_TIMEOUT_SECONDS=15
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME="EU Tools"