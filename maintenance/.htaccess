Options -Indexes -MultiViews
DirectoryIndex public/index.php

<FilesMatch "(^\.|\.sql$|\.log$|\.ini$|^README.*\.md$|^DEPLOYMENT_ORDER\.txt$|^composer\.(json|lock)$)">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /maintenance/

  # =========================================================
  # Flujos de identidad migrados al Core
  # =========================================================

  RewriteRule ^register\.html$ /register [R=302,L,NE,NC]
  RewriteRule ^verify-email\.html$ /verify-email [R=302,L,NE,NC]

  # =========================================================
  # Protección de capas privadas
  # =========================================================

  RewriteRule ^(?:app|bootstrap|scripts|sql|storage|vendor)(?:/|$) - [F,L,NC]

  # =========================================================
  # Evita ciclos sobre reescrituras internas
  # =========================================================

  RewriteRule ^public(?:/|$) - [L]

  # =========================================================
  # Assets y API propios de Maintenance
  # =========================================================

  RewriteRule ^assets/(.*)$ public/assets/$1 [L,NC]
  RewriteRule ^api/(.*)$ public/api/$1 [L,NC]

  # =========================================================
  # Páginas públicas propias de Maintenance
  # =========================================================

  RewriteRule ^(login|accept-invitation|change-password|dashboard|new-ticket|ticket|tickets|users|profile|forgot-password|reset-password)\.html$ public/$1.html [L,NC]

  # =========================================================
  # Entrada principal de Maintenance
  # =========================================================

  RewriteRule ^$ public/index.php [L]

</IfModule>