Options -Indexes -MultiViews
DirectoryIndex public/index.php

<FilesMatch "(^\.|\.sql$|\.log$|\.ini$|^README.*\.md$|^DEPLOYMENT_ORDER\.txt$|^composer\.(json|lock)$)">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /maintenance/

  # =========================================================
  # Identidad y administración global pertenecen al Core
  # =========================================================

  RewriteRule ^(?:public/)?login\.html$ /login [R=302,L,NE,NC]
  RewriteRule ^(?:public/)?register\.html$ /register [R=302,L,NE,NC]
  RewriteRule ^(?:public/)?verify-email\.html$ /verify-email [R=302,L,NE,NC]
  RewriteRule ^(?:public/)?accept-invitation\.html$ /accept-invitation [R=302,L,NE,NC]
  RewriteRule ^(?:public/)?forgot-password\.html$ /forgot-password [R=302,L,NE,NC]
  RewriteRule ^(?:public/)?reset-password\.html$ /reset-password [R=302,L,NE,NC]
  RewriteRule ^(?:public/)?change-password\.html$ /change-password [R=302,L,NE,NC]
  RewriteRule ^(?:public/)?profile\.html$ /account [R=302,L,NE,NC]
  RewriteRule ^(?:public/)?users\.html$ /admin/users [R=302,L,NE,NC]

  # =========================================================
  # Protección de capas privadas
  # =========================================================

  RewriteRule ^(?:app|bootstrap|scripts|sql|storage|vendor)(?:/|$) - [F,L,NC]

  # =========================================================
  # Canonicalización de páginas operativas
  # =========================================================

  RewriteRule ^public/(dashboard|new-ticket|ticket|tickets)\.html$ /maintenance/$1.html [R=302,L,NE,NC]

  # =========================================================
  # Evita ciclos sobre reescrituras internas
  # =========================================================

  RewriteRule ^public(?:/|$) - [L]

  # =========================================================
  # Assets y API propios de Maintenance
  # =========================================================

  RewriteRule ^assets/(.*)$ public/assets/$1 [L,NC]
  RewriteRule ^api/(.*)$ public/api/$1 [L,NC]

  # =========================================================
  # Páginas operativas propias de Maintenance
  # Gate server-side antes de enviar cualquier HTML.
  # =========================================================

  RewriteRule ^(dashboard|new-ticket|ticket|tickets)\.html$ public/operational.php?view=$1 [L,QSA,NC]

  # =========================================================
  # Entrada principal de Maintenance
  # =========================================================

  RewriteRule ^$ public/index.php [L]

</IfModule>